# ==============================================================================
# CyberSathi Frontend — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.
# Only VITE_* variables are included in the browser bundle.
# NEVER put secrets (JWT keys, DB passwords, API keys) here.
# ==============================================================================

# Backend API base URL
# Development:
VITE_API_URL=http://127.0.0.1:8000
# Production (set after deploying backend):
# VITE_API_URL=https://your-backend.onrender.com
